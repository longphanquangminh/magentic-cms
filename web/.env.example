# Server-only
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=          # Editor token (sanity.io/manage → API → Tokens)
GEMINI_API_KEY=            # aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CROWD_MODEL=gemini-3.5-flash-lite
# Optional: another Gemini model available on your SAME key. No automatic failover unless set.
GEMINI_FALLBACK_MODEL=
# Optional composer-only shared demo gate. NOT full app authentication or quota protection.
DEMO_ACCESS_CODE=

# Tuning (optional)
SIM_BATCH_SIZE=8           # personas per model call
SIM_PARALLEL_CALLS=2       # model calls per step
SIM_MAX_PERSONAS=120

# Public
NEXT_PUBLIC_STUDIO_URL=    # e.g. https://magenticcms.sanity.studio
